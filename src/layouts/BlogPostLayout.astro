---
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  keywords: string;
  category: string;
  publishedAt: string;
  imageUrl: string;
  slug: string;
}

const { title, description, keywords, category, publishedAt, imageUrl, slug } = Astro.props;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title, href: `/blog/${slug}` }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": imageUrl,
  "datePublished": publishedAt,
  "author": {
    "@type": "Organization",
    "name": "UK Rivers Directory"
  },
  "publisher": {
    "@type": "Organization",
    "name": "UK Rivers Directory",
    "logo": {
      "@type": "ImageObject",
      "url": `${Astro.site}favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(`/blog/${slug}`, Astro.site).toString()
  }
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={imageUrl}
  type="article"
  schemaData={schemaData}
>
  <Breadcrumb items={breadcrumbItems} />

  <article class="blog-post">
    <header class="post-header">
      <div class="container">
        <div class="post-meta">
          <span class="category-badge">{category}</span>
          <time datetime={publishedAt}>
            {new Date(publishedAt).toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            })}
          </time>
        </div>
        <h1>{title}</h1>
        <p class="post-intro">{description}</p>
      </div>
    </header>

    <div class="featured-image">
      <img src={imageUrl} alt={title} width="1200" height="600" loading="eager" fetchpriority="high" />
    </div>

    <div class="post-content">
      <div class="container">
        <div class="content-wrapper">
          <aside class="table-of-contents">
            <h2>Table of Contents</h2>
            <nav>
              <slot name="toc" />
            </nav>
          </aside>
          <div class="main-content">
            <slot />
          </div>
        </div>
      </div>
    </div>

    <footer class="post-footer">
      <div class="container">
        <div class="share-section">
          <h3>Found this helpful? Share it!</h3>
          <p>Help others discover UK rivers information</p>
        </div>
        <div class="back-to-blog">
          <a href="/blog" class="btn-primary">← Back to Blog</a>
        </div>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 calc(var(--spacing-unit) * 3);
  }

  .post-header {
    padding: calc(var(--spacing-unit) * 6) 0 calc(var(--spacing-unit) * 4);
    background: var(--color-background-alt);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
    margin-bottom: calc(var(--spacing-unit) * 3);
  }

  .category-badge {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: calc(var(--spacing-unit) * 1) calc(var(--spacing-unit) * 2);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  time {
    color: var(--color-text-light);
    font-size: 0.95rem;
  }

  .post-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: calc(var(--spacing-unit) * 3);
    line-height: 1.2;
  }

  .post-intro {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--color-text-light);
    max-width: 800px;
  }

  .featured-image {
    width: 100%;
    max-height: 500px;
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content {
    padding: calc(var(--spacing-unit) * 8) 0;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: calc(var(--spacing-unit) * 6);
    align-items: start;
  }

  .table-of-contents {
    position: sticky;
    top: calc(var(--spacing-unit) * 3);
    background: var(--color-background-alt);
    padding: calc(var(--spacing-unit) * 3);
    border-radius: 12px;
    border: 2px solid var(--color-border);
  }

  .table-of-contents h2 {
    font-size: 1.125rem;
    margin-bottom: calc(var(--spacing-unit) * 2);
  }

  .table-of-contents nav {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 1.5);
  }

  .table-of-contents :global(a) {
    color: var(--color-text-light);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .table-of-contents :global(a:hover) {
    color: var(--color-primary);
  }

  .main-content {
    max-width: 800px;
  }

  .main-content :global(h2) {
    font-size: 2rem;
    margin-top: calc(var(--spacing-unit) * 6);
    margin-bottom: calc(var(--spacing-unit) * 3);
    scroll-margin-top: calc(var(--spacing-unit) * 3);
  }

  .main-content :global(h3) {
    font-size: 1.5rem;
    margin-top: calc(var(--spacing-unit) * 4);
    margin-bottom: calc(var(--spacing-unit) * 2);
    scroll-margin-top: calc(var(--spacing-unit) * 3);
  }

  .main-content :global(p) {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin-bottom: calc(var(--spacing-unit) * 3);
  }

  .main-content :global(ul),
  .main-content :global(ol) {
    margin: calc(var(--spacing-unit) * 3) 0;
    padding-left: calc(var(--spacing-unit) * 4);
  }

  .main-content :global(li) {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin-bottom: calc(var(--spacing-unit) * 1.5);
  }

  .main-content :global(img) {
    width: 100%;
    border-radius: 12px;
    margin: calc(var(--spacing-unit) * 4) 0;
  }

  .main-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: calc(var(--spacing-unit) * 3);
    margin: calc(var(--spacing-unit) * 4) 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  .main-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .post-footer {
    padding: calc(var(--spacing-unit) * 8) 0;
    background: var(--color-background-alt);
    border-top: 2px solid var(--color-border);
  }

  .post-footer .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .share-section h3 {
    margin-bottom: calc(var(--spacing-unit) * 1);
  }

  .share-section p {
    color: var(--color-text-light);
    margin: 0;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: calc(var(--spacing-unit) * 2) calc(var(--spacing-unit) * 4);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 102, 204, 0.3);
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .table-of-contents {
      position: relative;
      top: 0;
    }
  }

  @media (max-width: 768px) {
    .post-footer .container {
      flex-direction: column;
      gap: calc(var(--spacing-unit) * 3);
      text-align: center;
    }
  }
</style>
