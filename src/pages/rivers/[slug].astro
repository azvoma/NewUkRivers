                          <path d="M10 12L14 9L18 12" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                          <path d="M14 9V15" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      )}
                      {activity.icon === 'fishing' && (
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                          <circle cx="14" cy="14" r="14" fill="#dbeafe"/>
