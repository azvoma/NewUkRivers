        <div class="hero-stats">
          {river.origin && (
            <div class="hero-stat">
              <span class="stat-label">Source</span>
              <span class="stat-value">{river.origin}</span>
            </div>
          )}
          {river.mouth && (
            <div class="hero-stat">
              <span class="stat-label">Mouth</span>
              <span class="stat-value">{river.mouth}</span>
            </div>
          )}
          {river.activities.length > 0 && (
            <div class="hero-stat">
              <span class="stat-label">Activities</span>
              <span class="stat-value">{river.activities.length} available</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <section class="river-intro">
    <div class="container">
      <h2>About {river.name}</h2>
      <p class="lead">{river.description}</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <h2>{river.name} Photo Gallery</h2>
      <div class="gallery-grid">
        {galleryImages.map((image) => (
          <div class="gallery-item">
            <img src={image.url} alt={image.alt} loading="lazy" width="400" height="300" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="river-sidebar-section">
    <div class="container">
      <div class="river-sidebar-layout">
        <div class="river-sidebar-main">
          <RiverStatsWidget river={river} />
          <div class="map-widget">
