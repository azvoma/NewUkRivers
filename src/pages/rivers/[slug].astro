                          <path d="M11.5 12.5L9.5 16M16.5 12.5L18.5 16" stroke="#0066cc" stroke-width="1.25" stroke-linecap="round"/>
                          <path d="M9 21L12 14.5L15 17.5L18 13L21 16" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
