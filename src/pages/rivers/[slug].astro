                          <circle cx="19" cy="18" r="4" stroke="#0066cc" stroke-width="1.5" fill="none"/>
                          <path d="M9 18L14 10L19 18" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                          <path d="M12 10H17" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
