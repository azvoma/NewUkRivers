---
import Layout from '../../layouts/Layout.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RiverStatsWidget from '../../components/RiverStatsWidget.astro';
import GearSidebar from '../../components/GearSidebar.astro';
import WaterLevelWidget from '../../components/WaterLevelWidget.astro';
import RelatedRivers from '../../components/RelatedRivers.astro';
import RiverFactFile from '../../components/RiverFactFile.astro';
import { getRivers, getRiversByRegion } from '../../lib/supabase';

export async function getStaticPaths() {
  const rivers = getRivers();

  return rivers.map((river) => ({
    params: { slug: river.slug },
    props: { river },
  }));
}

const { river } = Astro.props;

const relatedRivers = getRiversByRegion(river.region)
  .filter(r => r.slug !== river.slug)
  .slice(0, 3);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Rivers Directory', href: '/rivers' },
  { label: river.region, href: `/rivers?region=${encodeURIComponent(river.region)}` },
  { label: river.name, href: `/rivers/${river.slug}` }
];

const riverUrl = new URL(`/rivers/${river.slug}`, Astro.site).toString();
const siteUrl = Astro.site?.toString() || "https://ukrivers.co.uk";

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Place",
    "name": river.name,
    "description": river.description,
    "url": riverUrl,
    "geo": river.origin && {
      "@type": "GeoCoordinates",
      "name": river.origin
    },
    "containedInPlace": {
      "@type": "AdministrativeArea",
      "name": river.region
    },
    ...(river.image_url && {
      "image": river.image_url
    }),
    ...(river.length_miles && {
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Length",
          "value": `${river.length_miles} miles (${river.length_km} km)`
        }
      ]
    })
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Rivers Directory",
        "item": `${siteUrl}rivers/`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": `Rivers in ${river.region}`,
        "item": `${siteUrl}rivers/?region=${encodeURIComponent(river.region)}`
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": river.name,
        "item": riverUrl
      }
    ]
  }
];

const faqs = [
  {
    question: `How long is the ${river.name}?`,
    answer: river.length_miles
      ? `The ${river.name} is ${river.length_miles} miles (${river.length_km} km) long, making it ${river.length_miles > 150 ? 'one of the longer' : 'a significant'} rivers in the UK.`
      : `The ${river.name} flows through ${river.region}, contributing to the UK's diverse river network.`
  },
  {
    question: `Where does the ${river.name} start and end?`,
    answer: `The ${river.name} rises at ${river.origin} and flows to ${river.mouth}. ${river.region === 'Scotland' ? 'Scottish rivers often flow through dramatic highland scenery.' : river.region === 'Wales' ? 'Welsh rivers are known for their beauty and salmon fishing.' : 'English rivers have played crucial roles in history and industry.'}`
  },
  {
    question: `What wildlife can I see along the ${river.name}?`,
    answer: river.wildlife && river.wildlife.length > 0
      ? `The ${river.name} supports diverse wildlife including ${river.wildlife.slice(0, 3).join(', ')}${river.wildlife.length > 3 ? ', and more' : ''}. Bring binoculars for the best wildlife watching experience.`
      : `The ${river.name} supports various wildlife species typical of UK rivers. Check with local wildlife trusts for current sightings.`
  },
  {
    question: `What activities are available on the ${river.name}?`,
    answer: river.activities && river.activities.length > 0
      ? `Popular activities on the ${river.name} include ${river.activities.slice(0, 4).join(', ')}${river.activities.length > 4 ? ', and more' : ''}. Always check local regulations and safety guidelines.`
      : `Various outdoor activities are available along the ${river.name}. Contact local tourism offices for current information.`
  },
  {
    question: `Is it safe to swim in the ${river.name}?`,
    answer: `${river.swimming_safety}. Always check current water quality, avoid swimming after heavy rain, never swim alone, and be aware of currents and underwater hazards.`
  },
  {
    question: river.has_gold ? `Can you find gold in the ${river.name}?` : `What makes the ${river.name} special?`,
    answer: river.has_gold
      ? `Yes, the ${river.name} is known to contain natural gold deposits. Gold panning requires landowner permission and proper equipment. The gold comes from erosion of gold-bearing rocks upstream.`
      : `The ${river.name} is special for its natural beauty, wildlife, and ${river.activities && river.activities.length > 0 ? 'recreational opportunities' : 'cultural significance'}. Each UK river has unique characteristics shaped by its geology and history.`
  }
];

