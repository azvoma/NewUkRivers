                  <p><strong>Length:</strong> {river.length_miles} miles ({river.length_km} km)</p>
                )}
              </div>
            </div>

            <div class="detail-card">
              <div class="detail-card-header">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 2C8 2 4 5 4 9C4 11.2 5.8 13 8 13C10.2 13 12 11.2 12 9C12 5 8 2 8 2Z" stroke="white" stroke-width="1.5" fill="none"/>
