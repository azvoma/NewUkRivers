              <iframe
                width="100%"
                height="280"
                style="border:0;display:block;"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src={`https://www.google.com/maps/embed/v1/place?key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8&q=${encodeURIComponent(river.origin + ', ' + river.region + ', UK')}&zoom=10`}>
              </iframe>
            </div>
          </div>

          <div class="details-grid-four">
            <div class="detail-card">
              <div class="detail-card-header">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 1C5.8 1 4 2.8 4 5C4 7.8 8 13 8 13C8 13 12 7.8 12 5C12 2.8 10.2 1 8 1Z" stroke="white" stroke-width="1.5" fill="none"/>
