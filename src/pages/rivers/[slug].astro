    'Ospreys returned to nest along the Spey in 1959 after 50 years\' absence.',
    'The Speyside Way follows 65 miles of the river.'
  ]
};

const didYouKnowFacts = riverSpecificFacts[river.slug] || [
  `The ${river.name} has been a vital waterway for centuries, supporting local communities and wildlife.`,
  `${river.region} is home to some of the UK's most beautiful river landscapes.`,
  `Many historical settlements were established along the ${river.name} due to its strategic importance.`,
  `The ${river.name} supports a rich ecosystem that includes rare and protected species.`
];

const tributaries = {
  'river-thames': ['River Kennet', 'River Wey', 'River Lea', 'River Cherwell'],
  'river-severn': ['River Avon', 'River Teme', 'River Stour', 'River Tern'],
  'river-tay': ['River Tummel', 'River Isla', 'River Earn', 'River Almond'],
  'river-wye': ['River Lugg', 'River Monnow', 'River Irfon'],
  'river-trent': ['River Dove', 'River Derwent', 'River Soar'],
  'river-dee-scotland': ['Water of Tanar', 'Geldie Burn', 'Water of Feugh'],
  'river-spey': ['River Feshie', 'River Dulnain', 'River Avon']
};

const riverTributaries = tributaries[river.slug] || [];

const eaStationIds: Record<string, string> = {
  'river-thames': '3400TH',
  'river-severn': '2621',
  'river-trent': '3108',
  'river-wye': '2126',
  'river-ouse-yorkshire': '2600OA',
  'river-avon-bristol': '3143TH',
  'river-medway': '3400ME',
};

const stationId = eaStationIds[river.slug];

const exploreActivities = [
  {
    title: 'Walking Routes',
    description: 'Discover scenic riverside paths and national trails that follow the course of the river.',
    available: river.activities.includes('Walking'),
    icon: 'walking'
  },
  {
    title: 'Cycling Paths',
    description: 'Explore dedicated cycle routes and quiet roads alongside the river valley.',
    available: river.activities.includes('Cycling'),
    icon: 'cycling'
  },
  {
    title: 'Water Sports',
    description: 'Kayaking, canoeing, and paddleboarding opportunities along calm sections.',
    available: river.activities.includes('Kayaking') || river.activities.includes('Canoeing'),
    icon: 'watersports'
  },
  {
    title: 'Fishing Spots',
    description: 'Prime locations for coarse and game fishing with proper permits.',
    available: river.activities.includes('Fishing'),
    icon: 'fishing'
  },
  {
    title: 'Wildlife Watching',
    description: 'Birdwatching hides and viewpoints for observing river wildlife.',
    available: river.activities.includes('Wildlife Watching'),
    icon: 'wildlife'
  },
  {
    title: 'Camping Sites',
    description: 'Riverside campsites and wild camping areas for overnight stays.',
    available: river.activities.includes('Camping'),
    icon: 'camping'
  }
].filter(activity => activity.available);
---

<Layout
  title={`${river.name} | ${river.region} River Guide & Information`}
  description={`Explore ${river.name} in ${river.region}. ${river.description ? river.description.substring(0, 120) : `Discover wildlife, activities, and essential information about this ${river.region} river.`}`}
  keywords={`${river.name}, ${river.slug}, ${river.region} rivers, UK rivers, ${river.activities && river.activities.length > 0 ? river.activities.join(', ') : 'river activities'}`}
  image={river.image_url}
  type="article"
  schemaData={schemaData}
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="river-hero">
    <div class="hero-inner">
      <div class="container">
        <div class="hero-badge">{river.region}</div>
        <h1>{river.name}</h1>
        <p class="hero-subtitle">
          {river.length_miles ? `${river.length_miles} miles (${river.length_km} km)` : 'Major UK River'}
