                          <path d="M14 19L10 15" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
                          <path d="M14 19L18 15" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
                          <path d="M7 22C9 20 11 19 13 19C15 19 17 21.5 19 21.5C21 21.5 22 21 23 20" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                        </svg>
                      )}
                      {activity.icon === 'wildlife' && (
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                          <circle cx="14" cy="14" r="14" fill="#dbeafe"/>
                          <path d="M5 14C7.5 11 10 9.5 14 9.5C18 9.5 20.5 12.5 23 12.5" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round" fill="none"/>
