---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Resources', href: '/resources/' }
];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://ukrivers.co.uk';

const resources = [
  {
    title: 'Where can I find UK river conservation organisations?',
    answer: 'Our UK River Heroes Directory profiles over 20 national charities, local river trusts and grassroots campaigns working to protect British waterways.',
    detail: 'Browse the full directory to find river trusts in your area, learn about their work, and visit their websites to support or volunteer.',
    href: '/river-heroes/',
    internal: true,
    icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm14 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
    label: 'River Heroes'
  },
  {
    title: 'How can I check UK river water quality?',
    answer: 'The Environment Agency publishes live pollution and water quality data for every monitored river in England, while SEPA and NRW cover Scotland and Wales.',
    detail: 'Use the gov.uk bathing water quality tracker and the Rivers Trust sewage map to see real-time discharge alerts and pollution incidents near you.',
    href: 'https://environment.data.gov.uk/bwq/profiles',
    internal: false,
    icon: 'M22 12h-4l-3 9L9 3l-3 9H2',
    label: 'Water Quality Tracker'
  },
  {
    title: 'Is there a map of all UK rivers?',
    answer: 'Our UK River Mapping and A-Z Database lists every major British river with its length, source, mouth and key facts in one searchable place.',
    detail: 'Filter by region, length or activity to find the river you need, then click through to individual river pages for maps, photos and local guides.',
    href: '/rivers/',
    internal: true,
    icon: 'M9 20l-5.447-2.724A1 1 0 0 1 3 16.382V5.618a1 1 0 0 1 1.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0 0 21 18.382V7.618a1 1 0 0 0-.553-.894L15 4m0 13V4m0 0L9 7',
    label: 'A-Z River Database'
  },
  {
    title: 'Do I need a licence to fish or paddleboard on a UK river?',
    answer: 'You need an Environment Agency rod licence to fish in England and Wales, plus a permit or day ticket from the fishery owner. Paddleboarders require a British Canoeing licence on many waterways.',
    detail: 'Check our fishing regulations guide and paddling access code for the full breakdown of byelaws, licence types and where to buy them.',
    href: '/blog/do-i-need-a-license-to-paddleboard-on-a-river/',
    internal: true,
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0 1 12 2.944a11.955 11.955 0 0 1-8.618 3.04A12.02 12.02 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    label: 'Fishing & Paddling Rules'
  },
  {
    title: 'What are the rules for paddling and access on UK rivers?',
    answer: 'British Canoeing publishes the Water Safety Code and access guidance covering where you can paddle, portage rights and portage safety on UK waterways.',
    detail: 'Their licence gives access to over 4,500km of navigations. Always check local access agreements before heading out, as rights vary between England, Scotland and Wales.',
    href: 'https://www.britishcanoeing.org.uk/',
    internal: false,
    icon: 'M3 12h18M3 6h18M3 18h18',
    label: 'Paddling Access Code'
  },
  {
    title: 'What wildlife lives in and around UK rivers?',
    answer: 'UK rivers support otters, kingfishers, Atlantic salmon, water voles, mayflies and over 40 species of freshwater fish, all tracked by conservation charities.',
    detail: 'Our Freshwater Wildlife Guide covers how to identify key species, where to spot them, and which conservation status applies to each one.',
    href: '/river-heroes/',
    internal: true,
    icon: 'M12 2v20M2 12h20',
    label: 'Wildlife Guide'
  },
  {
    title: 'How do I get involved in citizen science for rivers?',
    answer: 'The Riverfly Partnership and FreshWater Watch train volunteers to sample and monitor invertebrate and water quality data on rivers across the UK.',
    detail: 'Sampling takes around 30 minutes per month and feeds directly into the national water quality evidence base used by the Environment Agency.',
    href: 'https://www.riverflies.org/',
    internal: false,
    icon: 'M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
    label: 'Citizen Science Hub'
  },
  {
    title: 'Where can I find river clean-up volunteer days near me?',
    answer: 'Thames21, The Rivers Trust network and Surfers Against Sewage run regular community clean-up events searchable by region on their websites.',
    detail: 'Most events provide equipment and training on the day. You can also start your own clean-up using their free organising toolkits and resources.',
    href: 'https://www.thames21.org.uk/',
    internal: false,
    icon: 'M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16',
    label: 'Volunteer Clean-Ups'
  }
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "UK River Resources Directory",
  "numberOfItems": resources.length,
  "itemListElement": resources.map((r, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Thing",
      "name": r.label,
      "description": r.answer,
      "url": r.internal ? `${siteUrl}${r.href}` : r.href
    }
  }))
};

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "UK River Resources, Guides & Conservation Directory",
  "description": "Explore essential UK river resources, live water monitoring tools, conservation groups, and our comprehensive UK River Heroes directory. Plan and protect.",
  "url": `${siteUrl}/resources/`,
  "isPartOf": {
    "@type": "WebSite",
    "name": "UK Rivers Directory",
    "url": siteUrl
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where can I find local river trusts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our UK River Heroes Directory at /river-heroes/ profiles over 20 national charities and local river trusts, including The Rivers Trust, Thames21, Bristol Avon Rivers Trust and Afonydd Cymru. Browse the directory to find and support trusts working in your catchment area."
      }
    },
    {
      "@type": "Question",
      "name": "How can I check UK river water quality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Environment Agency publishes live water quality and pollution data for England on environment.data.gov.uk. The Rivers Trust sewage map shows real-time discharge alerts, while SEPA and NRW cover Scotland and Wales respectively."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a licence to fish on a UK river?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You need an Environment Agency rod licence to fish in England and Wales, plus a permit or day ticket from the fishery owner. In Scotland, most freshwater fishing requires permission from the local district salmon fishery board."
      }
    }
  ]
};

const schemaData = [collectionPageSchema, itemListSchema, faqSchema];
---

<Layout
  title="UK River Resources, Guides & Conservation Directory"
  description="Explore essential UK river resources, live water monitoring tools, conservation groups, and our comprehensive UK River Heroes directory. Plan and protect."
  keywords="uk river resources, river water quality uk, river conservation uk, uk river trusts, river volunteer uk, citizen science rivers, uk fishing licence"
  schemaData={schemaData}
>
  <Breadcrumb items={breadcrumbItems} />

  <Hero
    title="UK River Resources"
    subtitle="Your definitive toolkit for exploring, monitoring, and protecting British waterways."
  />

  <!-- Resource cards grid -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-2">Essential River Resources</h2>
      <p class="text-slate-600 mb-10 max-w-2xl">
        Eight hand-picked tools and directories to help you explore, monitor and protect UK rivers.
        Each card links directly to the resource you need.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {resources.slice(0, 4).map((resource) => (
          <article class="resource-card group relative bg-slate-50 border border-slate-200 rounded-xl p-6 transition-all duration-300 hover:border-blue-500 hover:shadow-lg hover:-translate-y-1">
            <div class="flex items-start gap-4 mb-3">
              <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-blue-600 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={resource.icon} />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-base font-bold text-slate-800 leading-snug">{resource.title}</h3>
              </div>
            </div>
            <p class="text-sm text-slate-700 leading-relaxed mb-2 font-medium">{resource.answer}</p>
            <p class="text-sm text-slate-500 leading-relaxed">{resource.detail}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-semibold text-blue-700 group-hover:text-blue-900 transition-colors">
              {resource.label}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <a
              href={resource.href}
              {...(resource.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
              class="absolute inset-0 z-10"
              aria-label={resource.label}
            >
              <span class="sr-only">{resource.label}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter integration -->
  <section class="py-12 md:py-16 bg-blue-700">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">River Guide Newsletter</h2>
      <p class="text-blue-100 text-lg mb-8">Water level alerts, fishing reports &amp; river news — delivered straight to your inbox.</p>
      <form id="resource-newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input
          type="email"
          name="email"
          placeholder="Enter your email"
          required
          aria-label="Email address"
          class="flex-1 px-4 py-3 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-300"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-white text-blue-700 font-semibold rounded-lg hover:bg-blue-50 transition-colors whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>
      <p id="resource-newsletter-msg" class="text-blue-100 text-sm mt-4 hidden" role="status"></p>
      <p class="text-blue-200 text-xs mt-3">Free. No spam. Unsubscribe anytime.</p>
    </div>
  </section>

  <!-- Remaining resource cards -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {resources.slice(4).map((resource) => (
          <article class="resource-card group relative bg-slate-50 border border-slate-200 rounded-xl p-6 transition-all duration-300 hover:border-blue-500 hover:shadow-lg hover:-translate-y-1">
            <div class="flex items-start gap-4 mb-3">
              <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-blue-600 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={resource.icon} />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-base font-bold text-slate-800 leading-snug">{resource.title}</h3>
              </div>
            </div>
            <p class="text-sm text-slate-700 leading-relaxed mb-2 font-medium">{resource.answer}</p>
            <p class="text-sm text-slate-500 leading-relaxed">{resource.detail}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-semibold text-blue-700 group-hover:text-blue-900 transition-colors">
              {resource.label}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <a
              href={resource.href}
              {...(resource.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
              class="absolute inset-0 z-10"
              aria-label={resource.label}
            >
              <span class="sr-only">{resource.label}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('resource-newsletter-form');
    const msg = document.getElementById('resource-newsletter-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[name="email"]') as HTMLInputElement;
      const email = input.value.trim();
      if (!email) return;
      msg!.textContent = 'Subscribing…';
      msg!.classList.remove('hidden');
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        if (res.ok) {
          msg!.textContent = 'You are subscribed! Check your inbox to confirm.';
          input.value = '';
        } else {
          msg!.textContent = 'Something went wrong. Please try again later.';
        }
      } catch {
        msg!.textContent = 'Network error. Please try again later.';
      }
    });
  </script>
</Layout>
