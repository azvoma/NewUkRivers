---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import AdWidgetCard from '../components/ads/AdWidgetCard.astro';
import { getBlogPosts } from '../lib/supabase';

const blogPosts = getBlogPosts().sort((a, b) =>
  new Date(b.published_at!).getTime() - new Date(a.published_at!).getTime()
);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' }
];

const categories = ['Wildlife', 'Activities', 'Safety', 'Conservation', 'Geography', 'Fishing'];

const faqs = [
  {
    question: "What animals live in rivers in the UK?",
    answer: "UK rivers support incredible biodiversity including otters, water voles, kingfishers, herons, swans, various duck species, fish (salmon, trout, pike, perch), dragonflies, damselflies, and many invertebrates. Some rivers near estuaries also host seals."
  },
  {
    question: "What are chalk rivers in the UK?",
    answer: "Chalk rivers are globally rare freshwater habitats where water flows over chalk bedrock. The UK has 85% of the world's chalk streams. These rivers have crystal-clear water, stable temperatures, and support unique ecosystems including rare species and beautiful aquatic plants like water crowfoot."
  },
  {
    question: "Is it safe to swim in UK rivers?",
    answer: "Wild swimming in UK rivers can be safe with proper precautions. Always check water quality, be aware of currents and hazards, never swim alone, and consider water temperature. Many rivers have designated safe swimming areas monitored during summer. Avoid swimming after heavy rain when water quality may be compromised."
  },
  {
    question: "What plants grow near UK rivers?",
    answer: "UK riverbanks host rich plant communities including willows, alders, rushes, reeds, water crowfoot, yellow flag iris, marsh marigold, meadowsweet, purple loosestrife, and various sedges. These plants provide habitat for wildlife and help stabilize riverbanks."
  },
  {
    question: "When can you fish in UK rivers?",
    answer: "Coarse fishing is generally available year-round, though some waters have closed seasons. Salmon and sea trout fishing typically runs from spring to autumn with closed seasons in winter for conservation. Always check local regulations, obtain proper licenses, and respect closed seasons."
  },
  {
    question: "What are the longest rivers in the UK?",
    answer: "The River Severn is the longest at 220 miles (354 km), followed by the River Thames at 215 miles (346 km), River Trent at 185 miles (297 km), River Tay in Scotland at 120 miles (193 km), and the River Clyde at 109 miles (176 km)."
  }
];
---

<Layout
  title="UK Rivers Blog | Wildlife, Maps, Activities & River Facts"
  description="Read expert articles about UK rivers, wildlife, river maps, activities, and fun facts. Learn about fishing seasons, wild swimming, plants, and river safety."
  keywords="uk rivers blog, river wildlife uk, river activities uk, uk rivers guide"
>
  <Breadcrumb items={breadcrumbItems} />
  <Hero
    title="UK Rivers Blog: Guides, Wildlife, Maps & Activities"
    subtitle="Educational articles covering river wildlife, conservation, maps, activities, and fun facts"
  />

  <div class="blog-banner-ad">
    <div class="container">
      <AdWidgetCard>
        <a class="ad-creative" href="https://www.awin1.com/cread.php?s=4739011&v=1963&q=334515&r=3008603" rel="sponsored" target="_blank">
          <img src="/images/ads/imgsummer-mdh-300x250px-1781194981092%20copy.jpg" alt="Macdonald Hotels — Summer stays in Britain" border="0" loading="lazy" />
        </a>
      </AdWidgetCard>
    </div>
  </div>

  <section class="intro-section">
    <div class="container">
      <h2>Expert Insights on UK Rivers, Wildlife & Conservation</h2>
      <p class="centered-text">
        Our UK Rivers Blog offers a comprehensive collection of educational articles covering rivers in the UK, including detailed guides about river wildlife, conservation efforts, interactive maps of rivers in the UK, outdoor activities, and fascinating facts about British waterways. Whether you want to learn about chalk rivers that represent 85% of the world's chalk streams, discover which are the longest rivers in the UK, identify fish species in major rivers in the UK, or understand wild swimming safety guidelines, our blog provides expert content written for students, outdoor enthusiasts, and conservation advocates. From the River Thames to Scottish Highland rivers, we cover the diverse rivers of the UK with accurate information backed by research and local knowledge.
      </p>
      <p class="centered-text">
        Each article about UK rivers follows SEO best practices and Google quality guidelines to ensure readers find accurate, helpful, and trustworthy information about Britain's waterways. Our content explores the map of UK rivers through detailed regional guides, seasonal fishing tutorials, riverside camping recommendations, wildlife identification guides, and environmental conservation insights. Browse our growing library to discover practical advice for exploring rivers in the UK responsibly, understanding the ecological importance of these waterways, and learning about the cultural and historical significance of major rivers in the UK throughout England, Scotland, Wales, and Northern Ireland.
      </p>
    </div>
  </section>

  <section class="categories-section">
    <div class="container">
      <h2>Browse by Category</h2>
      <div class="categories-grid">
        {categories.map((category) => (
          <div class="category-badge">{category}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="blog-posts-section">
    <div class="container">
      <div class="blog-grid">
        {blogPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="blog-card">
            <div class="blog-category">{post.category}</div>
            <h3>{post.title}</h3>
            {post.excerpt && (
              <p class="blog-excerpt">{post.excerpt}</p>
            )}
            <div class="blog-meta">
              <span class="blog-date">
                {new Date(post.published_at!).toLocaleDateString('en-GB', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric'
                })}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bottom-section">
    <div class="container">
      <h2>Stay Connected with UK Rivers Knowledge</h2>
      <p>
        Stay updated with new articles and resources added weekly as we explore the fascinating world of UK rivers. Our mission is to make UK river knowledge accessible, engaging, and enjoyable for everyone interested in Britain's waterways. From educational content about the longest rivers in the UK to practical guides on river activities, our blog covers every aspect of exploring and understanding rivers in the United Kingdom.
      </p>
      <p>
        Our expert writers provide insights into river wildlife, conservation efforts, fishing regulations, and outdoor activities along major rivers in the UK. Whether you're curious about chalk rivers, interested in salmon migration patterns, or planning riverside adventures, our blog delivers well-researched, SEO-optimized content that helps you discover the rivers of the UK in depth. Each article follows Google guidelines while maintaining readability and providing genuine value to readers seeking information about UK rivers and their ecosystems.
      </p>
      <p>
        Explore topics ranging from the geography of UK rivers to safety tips for wild swimming, from identifying riverbank plants to understanding the cultural significance of famous waterways. Our comprehensive blog serves students, outdoor enthusiasts, and nature lovers who want to deepen their knowledge of the map of rivers in UK territories and learn how to enjoy these natural treasures responsibly and sustainably.
      </p>
    </div>
  </section>

  <FAQ faqs={faqs} />
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 calc(var(--spacing-unit) * 3);
  }

  .blog-banner-ad {
    padding: calc(var(--spacing-unit) * 2) 0;
  }

  .intro-section {
    padding: calc(var(--spacing-unit) * 8) 0;
    background: var(--color-background-alt);
  }

  .intro-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 4);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .intro-section p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .centered-text {
    text-align: center;
  }

  .categories-section {
    padding: calc(var(--spacing-unit) * 8) 0;
  }

  .categories-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 4);
  }

  .categories-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(var(--spacing-unit) * 2);
  }

  .category-badge {
    background: var(--color-primary);
    color: white;
    padding: calc(var(--spacing-unit) * 1.5) calc(var(--spacing-unit) * 3);
    border-radius: 25px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .category-badge:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .blog-posts-section {
    padding: calc(var(--spacing-unit) * 8) 0 calc(var(--spacing-unit) * 10);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: calc(var(--spacing-unit) * 3);
  }

  .blog-card {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    padding: calc(var(--spacing-unit) * 4);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 2);
    text-decoration: none;
    color: inherit;
  }

  .blog-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 102, 204, 0.12);
    transform: translateY(-4px);
  }

  .blog-category {
    display: inline-block;
    background: var(--color-secondary);
    color: white;
    padding: calc(var(--spacing-unit) * 0.75) calc(var(--spacing-unit) * 1.5);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    align-self: flex-start;
  }

  .blog-card h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--color-text);
    line-height: 1.3;
  }

  .blog-excerpt {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
    padding-top: calc(var(--spacing-unit) * 2);
    border-top: 1px solid var(--color-border);
  }

  .blog-date {
    color: var(--color-text-light);
    font-size: 0.875rem;
  }

  .bottom-section {
    padding: calc(var(--spacing-unit) * 8) 0;
    background: var(--color-background-alt);
  }

  .bottom-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 3);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .bottom-section p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
