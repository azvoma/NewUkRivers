---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import RiverCard from '../components/RiverCard.astro';
import FAQ from '../components/FAQ.astro';
import { supabase } from '../lib/supabase';

const { data: allRivers } = await supabase
  .from('rivers')
  .select('*')
  .order('name');

const faqs = [
  {
    question: "What are the cleanest rivers in the UK?",
    answer: "Chalk rivers like the River Itchen and River Test are among the cleanest, with crystal-clear water flowing over chalk bedrock. Many Scottish Highland rivers also maintain excellent water quality due to minimal pollution and natural filtration through peat and rock."
  },
  {
    question: "Which UK rivers contain gold?",
    answer: "The River Tay and River Dee in Scotland are known for containing gold deposits. Small amounts of gold can be found in several other Scottish and Welsh rivers, deposited through natural erosion of gold-bearing rocks in the highlands."
  },
  {
    question: "When can you fish in UK rivers?",
    answer: "Fishing seasons vary by species and region. Coarse fishing is typically available year-round, while salmon and trout have closed seasons (usually October to March for salmon). Always check local regulations and obtain proper permits before fishing."
  },
  {
    question: "What are the best campsites near rivers in the UK?",
    answer: "Popular riverside camping areas include the River Wye valley, Thames riverside sites, Scottish Highland rivers, and Lake District rivers. Many offer facilities for water activities, fishing, and nature walks."
  },
  {
    question: "What fish live in UK rivers?",
    answer: "UK rivers support diverse fish species including salmon, brown trout, sea trout, pike, perch, roach, chub, barbel, bream, carp, and various others. Chalk rivers are particularly important for brown trout populations."
  },
  {
    question: "What is the longest river in the UK?",
    answer: "The River Severn is the longest river in the United Kingdom at 220 miles (354 km), flowing from Wales through England to the Bristol Channel. The River Thames is the second longest at 215 miles (346 km)."
  }
];
---

<Layout
  title="Rivers in the UK | Complete UK Rivers Directory & Map"
  description="Browse all rivers in the UK with names A–Z. Explore river maps, facts, wildlife, activities, and regional river guides."
  keywords="rivers in the uk, uk rivers, map rivers in uk, names of rivers in the uk"
>
  <Hero
    title="Explore All Rivers in the UK: A–Z River Directory"
    subtitle="Hundreds of rivers flowing through England, Scotland, Wales, and Northern Ireland"
    showSearch={true}
    searchId="rivers-search"
  />

  <section class="intro-section">
    <div class="container">
      <h2>Explore Every Major River Across the United Kingdom</h2>
      <p>
        With hundreds of rivers flowing through England, Scotland, Wales, and Northern Ireland, the UK has a rich network of waterways waiting to be explored. This page features every river in the UK, listed alphabetically and regionally for easy navigation.
      </p>
      <p>
        Whether you're researching names of rivers in the UK or planning a trip to a specific region, our comprehensive directory provides essential details, wildlife facts, and interactive river maps.
      </p>
    </div>
  </section>

  <section class="rivers-directory">
    <div class="container">
      <div id="rivers-grid" class="rivers-grid">
        {allRivers && allRivers.map((river) => (
          <RiverCard river={river} />
        ))}
      </div>
      <div id="no-results" class="no-results" style="display: none;">
        <p>No rivers found matching your search criteria.</p>
      </div>
    </div>
  </section>

  <section class="bottom-section">
    <div class="container">
      <h2>Your Gateway to UK River Exploration</h2>
      <p>
        Our UK river index is designed for students, hikers, campers, and anyone who enjoys discovering waterways. Dive into each river page to learn about its history, wildlife, activities, and conservation status. This comprehensive directory features rivers in the UK from all four nations, providing detailed information about the names of rivers in the UK, their locations, lengths, and unique characteristics that make each waterway special.
      </p>
      <p>
        Whether you're searching for the longest rivers in the UK or exploring smaller tributaries, our map rivers in UK database includes extensive details about each watercourse. From the River Severn flowing 220 miles through Wales and England, to Scottish salmon rivers like the Tay and Spey, to Welsh valleys carved by the Wye and Usk, the diversity of UK rivers reflects the rich geographical and ecological heritage of the British Isles. Each river entry provides practical information for visitors, conservationists, and researchers.
      </p>
      <p>
        Use our search and filter tools to discover rivers by region, length, activities, or wildlife. Learn about fishing seasons, kayaking opportunities, riverside camping, and wildlife watching along major rivers in the UK. Our directory combines historical context, ecological information, and practical guidance to help you appreciate and explore the rivers of the UK responsibly. Start your journey through Britain's waterways today and discover the natural wonders that flow through our landscapes.
      </p>
    </div>
  </section>

  <FAQ faqs={faqs} />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const searchForm = document.getElementById('rivers-search-form') as HTMLFormElement;
  const searchInput = document.getElementById('rivers-search') as HTMLInputElement;
  const resultsContainer = document.getElementById('rivers-search-results') as HTMLElement;

  let searchTimeout: ReturnType<typeof setTimeout>;

  async function performSearch(searchTerm: string) {
    if (!searchTerm) {
      resultsContainer.innerHTML = '';
      return;
    }

    try {
      const { data: river, error } = await supabase
        .from('rivers')
        .select('*')
        .or(`name.ilike.%${searchTerm}%,region.ilike.%${searchTerm}%,origin.ilike.%${searchTerm}%,mouth.ilike.%${searchTerm}%`)
        .order('name')
        .limit(1)
        .maybeSingle();

      if (error) {
        console.error('Supabase error:', error);
        resultsContainer.innerHTML = `
          <div class="no-result">
            <p>An error occurred while searching. Please try again.</p>
          </div>
        `;
        return;
      }

      if (river) {
        resultsContainer.innerHTML = `
          <article class="search-result-card">
            ${river.image_url ? `<img src="${river.image_url}" alt="${river.name}" />` : ''}
            <div class="result-content">
              <h3>${river.name}</h3>
              <p class="result-region">${river.region} • ${river.length_miles ? `${river.length_miles} miles` : 'Major UK River'}</p>
              <p class="result-description">${river.description || 'Explore this beautiful UK river'}</p>
              <a href="/rivers/${river.slug}" class="result-link">View Full Details →</a>
            </div>
          </article>
        `;
      } else {
        resultsContainer.innerHTML = `
          <div class="no-result">
            <p>No river found matching "${searchTerm}". Try searching by river name or location (e.g., "Thames", "Scotland", or "Severn").</p>
          </div>
        `;
      }
    } catch (error) {
      console.error('Search error:', error);
      resultsContainer.innerHTML = `
        <div class="no-result">
          <p>An error occurred while searching. Please try again.</p>
        </div>
      `;
    }
  }

  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const searchTerm = searchInput.value.trim();
    performSearch(searchTerm);
  });

  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    const searchTerm = searchInput.value.trim();

    if (!searchTerm) {
      resultsContainer.innerHTML = '';
      return;
    }

    searchTimeout = setTimeout(() => {
      performSearch(searchTerm);
    }, 300);
  });
</script>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 calc(var(--spacing-unit) * 3);
  }

  .intro-section {
    padding: calc(var(--spacing-unit) * 8) 0;
    background: var(--color-background-alt);
  }

  .intro-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 4);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .intro-section p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .rivers-directory {
    padding: calc(var(--spacing-unit) * 6) 0 calc(var(--spacing-unit) * 10);
  }

  .rivers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: calc(var(--spacing-unit) * 3);
  }

  .no-results {
    text-align: center;
    padding: calc(var(--spacing-unit) * 8) 0;
  }

  .no-results p {
    font-size: 1.125rem;
    color: var(--color-text-light);
  }

  .bottom-section {
    padding: calc(var(--spacing-unit) * 8) 0;
    background: var(--color-background-alt);
  }

  .bottom-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 3);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .bottom-section p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  @media (max-width: 768px) {
    .rivers-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
