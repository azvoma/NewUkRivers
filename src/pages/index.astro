---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import RiverCard from '../components/RiverCard.astro';
import FAQ from '../components/FAQ.astro';
import { getRivers } from '../lib/supabase';

const featuredRivers = getRivers().filter(river => river.featured).slice(0, 6);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "UK Rivers Directory",
  "description": "Comprehensive guide to UK rivers with maps, facts, wildlife information, and activities.",
  "url": Astro.site?.toString() || "https://ukrivers.directory",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${Astro.site?.toString() || "https://ukrivers.directory"}/rivers?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

const faqs = [
  {
    question: "What are the longest rivers in the UK?",
    answer: "The River Severn is the longest river in the UK at 220 miles (354 km), followed by the River Thames at 215 miles (346 km), and the River Trent at 185 miles (297 km). These major rivers flow through England and have shaped British history and landscapes for centuries."
  },
  {
    question: "How many rivers are there in the UK?",
    answer: "The UK has hundreds of rivers of varying sizes. There are approximately 1,500 named rivers and streams throughout England, Scotland, Wales, and Northern Ireland, ranging from small tributaries to major waterways that support commerce, wildlife, and recreation."
  },
  {
    question: "Is it safe to swim in rivers in the UK?",
    answer: "Wild swimming in UK rivers can be safe in designated areas with proper precautions. Always check local water quality, be aware of currents and underwater hazards, never swim alone, and consider water temperature. Many rivers have specific safe swimming spots that are monitored during summer months."
  },
  {
    question: "What animals live in rivers in the UK?",
    answer: "UK rivers support diverse wildlife including otters, water voles, kingfishers, herons, swans, various fish species (salmon, trout, pike, perch), dragonflies, damselflies, and in some areas, seals near estuaries. Many rivers also host rare species like white-clawed crayfish and lamprey."
  },
  {
    question: "Are there campsites near rivers in the UK?",
    answer: "Yes, there are numerous campsites located near UK rivers, offering opportunities for riverside camping, fishing, and water activities. Popular riverside camping destinations include the River Wye, River Thames, and various Scottish rivers. Many sites offer facilities for kayaking, fishing, and nature walks."
  },
  {
    question: "What plants grow near rivers in the UK?",
    answer: "UK riverbanks support rich plant communities including willows, alders, rushes, reeds, water crowfoot, yellow flag iris, marsh marigold, meadowsweet, and various sedges. Chalk rivers are particularly special, supporting unique vegetation including water crowfoot that creates beautiful underwater meadows."
  }
];
---

<Layout
  title="UK Rivers | Guide to the Longest & Major Rivers in the UK"
  description="Explore all UK rivers with maps, facts, activities and guides. Discover the longest rivers in the UK, major rivers, and a detailed map of rivers in the UK."
  keywords="uk rivers, longest rivers in uk, rivers of the uk, map of rivers in uk, major rivers in the uk"
  type="website"
  schemaData={schemaData}
>
  <Hero
    title="Discover UK Rivers: Interactive Guide to All Major Rivers in the UK"
    subtitle="Explore hundreds of incredible rivers that shape landscapes, support wildlife, and provide endless opportunities for outdoor adventure"
  />

  <section class="intro-section">
    <div class="container">
      <h2>Your Complete Guide to Rivers in the United Kingdom</h2>
      <p>
        The UK is home to hundreds of incredible rivers that shape landscapes, support wildlife, and provide endless opportunities for outdoor adventure. Our directory brings together detailed information on every major river in the UK, including maps, wildlife facts, activities, and conservation insights.
      </p>
      <p>
        Whether you're researching the longest rivers in the UK, planning a riverside camping trip, or simply exploring the rivers of the UK for fun, this platform offers an easy-to-use and educational experience backed by accurate data, engaging visuals, and modern UX design.
      </p>
    </div>
  </section>

  <section class="rivers-section">
    <div class="container">
      <h2 class="section-title">Featured UK Rivers</h2>
      <div class="rivers-grid">
        {featuredRivers.map((river) => (
          <RiverCard river={river} />
        ))}
      </div>
      <div class="view-all-container">
        <a href="/rivers" class="view-all-button">View All Rivers →</a>
      </div>
    </div>
  </section>

  <section class="activities-section">
    <div class="container">
      <h2>Activities Around UK Rivers</h2>
      <div class="activities-grid">
        <div class="activity-card">
          <div class="activity-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#e8f4fd"/>
              <path d="M10 26C12 23 14 21 17 21C20 21 22 24 25 24C28 24 30 22 30 22" stroke="#0066cc" stroke-width="2" stroke-linecap="round" fill="none"/>
              <path d="M14 18L20 14L26 18" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <path d="M20 14V22" stroke="#0066cc" stroke-width="2" stroke-linecap="round"/>
              <path d="M8 21L13 18M32 21L27 18" stroke="#0066cc" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Kayaking & Canoeing</h3>
          <p>Explore scenic waterways and challenging rapids across the UK's diverse river systems.</p>
        </div>
        <div class="activity-card">
          <div class="activity-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#e8f4fd"/>
              <path d="M20 10V26" stroke="#0066cc" stroke-width="2" stroke-linecap="round"/>
              <path d="M20 26L15 22" stroke="#0066cc" stroke-width="2" stroke-linecap="round"/>
              <path d="M20 26L25 22" stroke="#0066cc" stroke-width="2" stroke-linecap="round"/>
              <path d="M10 30C13 27 15 25 18 25C21 25 23 28 26 28C28 28 29.5 27 32 25" stroke="#0066cc" stroke-width="2" stroke-linecap="round" fill="none"/>
              <circle cx="22" cy="13" r="2" fill="#0066cc" opacity="0.4"/>
            </svg>
          </div>
          <h3>Fishing</h3>
          <p>Discover the best fishing spots and learn about seasonal regulations for various species.</p>
        </div>
        <div class="activity-card">
          <div class="activity-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#e8f4fd"/>
              <path d="M10 28L20 12L30 28H10Z" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <path d="M15 28V22H25V28" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M18 22V19H22V22" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Riverside Camping</h3>
          <p>Find beautiful campsites near rivers for an unforgettable outdoor experience.</p>
        </div>
        <div class="activity-card">
          <div class="activity-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#e8f4fd"/>
              <path d="M13 30L17 22L21 27L25 18L30 24" stroke="#0066cc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <circle cx="20" cy="13" r="3" stroke="#0066cc" stroke-width="2" fill="none"/>
              <path d="M20 16V20" stroke="#0066cc" stroke-width="2" stroke-linecap="round"/>
              <path d="M17 18L14 22M23 18L26 22" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Walking Trails</h3>
          <p>Follow scenic riverside paths and discover the natural beauty of UK waterways.</p>
        </div>
        <div class="activity-card">
          <div class="activity-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#e8f4fd"/>
              <circle cx="20" cy="19" r="6" stroke="#0066cc" stroke-width="2" fill="none"/>
              <path d="M10 27C12 24 14 22 17 22C20 22 22 25 25 25C28 25 29.5 23 32 21" stroke="#0066cc" stroke-width="2" stroke-linecap="round" fill="none"/>
              <path d="M20 13V11M27 19H29M13 19H11" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Wild Swimming</h3>
          <p>Learn about safe swimming spots and water quality in UK rivers.</p>
        </div>
        <div class="activity-card">
          <div class="activity-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="20" cy="20" r="20" fill="#e8f4fd"/>
              <path d="M20 10C20 10 12 15 12 21C12 25 15.5 28 20 28C24.5 28 28 25 28 21C28 15 20 10 20 10Z" stroke="#0066cc" stroke-width="2" fill="none" stroke-linejoin="round"/>
              <path d="M14 19L20 14L26 19" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <path d="M20 14V22" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M16 22H24" stroke="#0066cc" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Wildlife Watching</h3>
          <p>Spot otters, kingfishers, herons, and other incredible wildlife along riverbanks.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="facts-section">
    <div class="container">
      <h2>Important & Fun Facts About UK Rivers</h2>
      <div class="facts-grid">
        <div class="fact-card">
          <div class="fact-number">220</div>
          <p>The River Severn is the longest in the UK at 220 miles</p>
        </div>
        <div class="fact-card">
          <div class="fact-number">85%</div>
          <p>The UK has 85% of the world's chalk rivers - globally rare habitats</p>
        </div>
        <div class="fact-card">
          <div class="fact-number">150+</div>
          <p>Over 150 fish species live in UK rivers</p>
        </div>
        <div class="fact-card">
          <div class="fact-icon">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M28 8L38 20H18L28 8Z" stroke="rgba(255,255,255,0.9)" stroke-width="2" stroke-linejoin="round" fill="rgba(255,255,255,0.2)"/>
              <path d="M18 20L28 48L38 20H18Z" stroke="rgba(255,255,255,0.9)" stroke-width="2" stroke-linejoin="round" fill="rgba(255,255,255,0.15)"/>
            </svg>
          </div>
          <p>Some UK rivers contain natural gold deposits</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bottom-text">
    <div class="container">
      <h2>Start Your UK Rivers Adventure Today</h2>
      <p class="spaced-paragraph">
        UK rivers offer an extraordinary blend of natural beauty, rich cultural heritage, and unforgettable outdoor experiences waiting to be discovered across Britain's diverse landscapes. From crystal-clear chalk streams that represent 85% of the world's chalk rivers to powerful Scottish Highland rivers flowing through dramatic mountain scenery, each river in the UK tells its own unique story of geological formation, ecological evolution, and human history. The rivers of the UK span diverse terrain across England, Scotland, Wales, and Northern Ireland, creating vital ecosystems that support abundant native wildlife including otters, kingfishers, salmon, and rare species while providing exceptional recreational opportunities for millions of visitors, students, and researchers each year.
      </p>
      <p class="spaced-paragraph">
        When exploring the longest rivers in the UK through our comprehensive directory, you'll discover that the River Severn leads at an impressive 220 miles (354 km), followed closely by the iconic River Thames at 215 miles (346 km), and the River Trent at 185 miles (297 km). These major rivers in the UK have profoundly shaped British history, powered industrial development, connected communities, and continue to serve as vital transportation corridors and irreplaceable ecological habitats. Our detailed and interactive map of rivers in UK territories helps you locate, research, and learn about each significant waterway, from world-famous rivers like the Thames and Severn to lesser-known hidden gems waiting to be explored, documented, and appreciated by nature enthusiasts and outdoor adventurers seeking authentic British experiences.
      </p>
    </div>
  </section>

  <FAQ faqs={faqs} />
</Layout>


<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 calc(var(--spacing-unit) * 3);
  }


  .intro-section {
    padding: calc(var(--spacing-unit) * 8) 0;
    background: var(--color-background-alt);
  }

  .intro-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 4);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .intro-section p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .rivers-section {
    padding: calc(var(--spacing-unit) * 10) 0;
  }

  .section-title {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 6);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .rivers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: calc(var(--spacing-unit) * 3);
  }

  .view-all-container {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--spacing-unit) * 6);
  }

  .view-all-button {
    background: var(--color-primary);
    color: white;
    padding: calc(var(--spacing-unit) * 2) calc(var(--spacing-unit) * 4);
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.125rem;
    transition: all 0.3s ease;
  }

  .view-all-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 102, 204, 0.3);
  }

  .activities-section {
    padding: calc(var(--spacing-unit) * 10) 0;
    background: var(--color-background-alt);
  }

  .activities-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 6);
  }

  .activities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: calc(var(--spacing-unit) * 3);
  }

  .activity-card {
    background: var(--color-background);
    padding: calc(var(--spacing-unit) * 4);
    border-radius: 12px;
    text-align: center;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .activity-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 102, 204, 0.12);
    transform: translateY(-4px);
  }

  .activity-icon {
    display: flex;
    justify-content: center;
    margin-bottom: calc(var(--spacing-unit) * 2);
  }

  .activity-card h3 {
    margin-bottom: calc(var(--spacing-unit) * 1.5);
    font-size: 1.25rem;
  }

  .activity-card p {
    color: var(--color-text-light);
    margin: 0;
    line-height: 1.6;
  }

  .facts-section {
    padding: calc(var(--spacing-unit) * 10) 0;
  }

  .facts-section h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 6);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: calc(var(--spacing-unit) * 3);
  }

  .fact-card {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white;
    padding: calc(var(--spacing-unit) * 4);
    border-radius: 12px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .fact-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 102, 204, 0.25);
  }

  .fact-number {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: calc(var(--spacing-unit) * 2);
    line-height: 1;
  }

  .fact-icon {
    display: flex;
    justify-content: center;
    margin-bottom: calc(var(--spacing-unit) * 2);
  }

  .fact-card p {
    font-size: 1.125rem;
    margin: 0;
    line-height: 1.5;
  }

  .bottom-text {
    padding: calc(var(--spacing-unit) * 8) 0;
    background: var(--color-background-alt);
  }

  .bottom-text h2 {
    text-align: center;
    margin-bottom: calc(var(--spacing-unit) * 3);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .bottom-text p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .spaced-paragraph {
    margin-bottom: calc(var(--spacing-unit) * 3);
  }

  @media (max-width: 768px) {
    .rivers-grid {
      grid-template-columns: 1fr;
    }

    .activities-grid {
      grid-template-columns: 1fr;
    }

    .facts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
