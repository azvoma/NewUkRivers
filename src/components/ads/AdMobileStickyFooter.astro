---
interface Props {
	label?: string;
}
const { label = 'Advertisement' } = Astro.props;
---

<div id="ad-mobile-sticky-footer" class="ad-mobile-sticky-footer">
	<div class="ad-inner" data-ad-size="320x50">
		<span class="ad-label">{label}</span>
		<slot />
	</div>
	<button
		type="button"
		class="ad-close"
		aria-label="Close advertisement"
		onclick="this.parentElement.remove()"
	>
		<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
			<path d="M2 2L12 12M12 2L2 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
		</svg>
	</button>
</div>

<style>
	.ad-mobile-sticky-footer {
		position: fixed;
		bottom: 0;
		left: 0;
		width: 100%;
		z-index: 50;
		display: flex;
		justify-content: center;
		align-items: center;
		background: var(--color-background);
		border-top: 1px solid var(--color-border);
		padding: calc(var(--spacing-unit) * 1) 0;
	}

	.ad-inner {
		background: var(--color-background-alt);
		border: 1px dashed var(--color-border);
		border-radius: 6px;
		width: 320px;
		height: 50px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.ad-label {
		position: absolute;
		top: 2px;
		left: 6px;
		font-size: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-light);
		opacity: 0.6;
	}

	.ad-close {
		position: absolute;
		top: 4px;
		right: 6px;
		background: rgba(0, 0, 0, 0.25);
		border: none;
		border-radius: 4px;
		padding: 3px;
		cursor: pointer;
		color: var(--color-text);
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 0;
	}

	.ad-close:hover {
		background: rgba(0, 0, 0, 0.45);
	}

	@media (min-width: 768px) {
		.ad-mobile-sticky-footer {
			display: none;
		}
	}
</style>
