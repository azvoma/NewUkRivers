---
interface Props {
	label?: string;
}
const { label = '' } = Astro.props;
---

<aside class="ad-sidebar-sticky">
	<div class="ad-inner" data-ad-size="300x600">
		{label && <span class="ad-label">{label}</span>}
		<slot />
	</div>
</aside>

<style>
	.ad-sidebar-sticky {
		position: sticky;
		top: calc(var(--spacing-unit) * 3);
		display: flex;
		justify-content: center;
	}

	.ad-inner {
		background: var(--color-background-alt);
		border: 1px dashed var(--color-border);
		border-radius: 8px;
		width: 300px;
		height: 600px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	:global(.ad-creative) {
		display: block;
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		text-decoration: none;
	}

	:global(.ad-creative > img) {
		width: 100% !important;
		height: 100% !important;
		max-width: none !important;
		max-height: none !important;
		object-fit: cover;
		margin: 0 !important;
	}

	:global(.ad-creative__copy) {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 1rem;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
		color: #fff;
		text-align: center;
		font-size: 0.9rem;
		line-height: 1.4;
	}

	:global(.ad-creative__copy strong) {
		display: block;
		color: #fff !important;
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}

	.ad-label {
		position: absolute;
		top: 4px;
		left: 8px;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-light);
		opacity: 0.6;
	}

	@media (max-width: 1023px) {
		.ad-sidebar-sticky {
			display: none;
		}
	}
</style>
