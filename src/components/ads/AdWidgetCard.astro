---
interface Props {
	label?: string;
}
const { label = '' } = Astro.props;
---

<div class="ad-widget-card">
	<div class="ad-inner" data-ad-size="300x250">
		{label && <span class="ad-label">{label}</span>}
		<slot />
	</div>
</div>

<style>
	.ad-widget-card {
		display: flex;
		margin: calc(var(--spacing-unit) * 4) 0;
		justify-content: center;
	}

	.ad-inner {
		background: var(--color-background-alt);
		border: 1px dashed var(--color-border);
		border-radius: 12px;
		width: 300px;
		height: 250px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
	}

	:global(.ad-creative) {
		display: block;
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		text-decoration: none;
	}

	:global(.ad-creative > img) {
		width: 100% !important;
		height: 100% !important;
		max-width: none !important;
		max-height: none !important;
		object-fit: cover;
		margin: 0 !important;
	}

	:global(.ad-creative__copy) {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.75rem;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
		color: #fff;
		text-align: center;
		font-size: 0.85rem;
		line-height: 1.4;
	}

	:global(.ad-creative__copy strong) {
		display: block;
		color: #fff !important;
		margin-bottom: 0.2rem;
		font-size: 1rem;
	}

	.ad-label {
		position: absolute;
		top: 4px;
		left: 8px;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-light);
		opacity: 0.6;
	}
</style>
