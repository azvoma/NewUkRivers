---
interface Props {
	label?: string;
}
const { label = '' } = Astro.props;
---

<div class="ad-leaderboard">
	<div class="ad-inner ad-desktop" data-ad-size="728x90">
		{label && <span class="ad-label">{label}</span>}
		<slot />
	</div>
	<div class="ad-inner ad-mobile" data-ad-size="320x50">
		{label && <span class="ad-label">{label}</span>}
		<slot name="mobile" />
	</div>
</div>

<style>
	.ad-leaderboard {
		display: flex;
		justify-content: center;
		width: 100%;
		padding: calc(var(--spacing-unit) * 2) 0;
	}

	.ad-inner {
		background: var(--color-background-alt);
		border: 1px dashed var(--color-border);
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.ad-desktop {
		width: 728px;
		height: 90px;
	}

	.ad-mobile {
		display: none;
		width: 320px;
		height: 50px;
	}

	:global(.ad-creative) {
		display: block;
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		text-decoration: none;
	}

	:global(.ad-creative > img) {
		width: 100% !important;
		height: 100% !important;
		max-width: none !important;
		max-height: none !important;
		object-fit: cover;
		margin: 0 !important;
	}

	.ad-label {
		position: absolute;
		top: 4px;
		left: 8px;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-light);
		opacity: 0.6;
	}

	@media (max-width: 767px) {
		.ad-desktop {
			display: none;
		}
		.ad-mobile {
			display: flex;
		}
	}
</style>
