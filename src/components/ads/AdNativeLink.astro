---
interface Props {
	href?: string;
	text?: string;
}
const { href = '#', text = 'Check Availability' } = Astro.props;
---

<div class="ad-native-link">
	<a href={href} class="ad-native-cta" rel="sponsored nofollow" target="_blank">
		{text}
		<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M3 8H13M13 8L8 3M13 8L8 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	</a>
</div>

<style>
	.ad-native-link {
		display: flex;
		margin: calc(var(--spacing-unit) * 4) 0;
	}

	.ad-native-cta {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--spacing-unit) * 1);
		background: var(--color-primary);
		color: #ffffff;
		padding: calc(var(--spacing-unit) * 1.5) calc(var(--spacing-unit) * 3);
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.ad-native-cta:hover {
		background: var(--color-primary-dark);
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(13, 59, 158, 0.3);
	}

	.ad-native-cta svg {
		transition: transform 0.2s ease;
	}

	.ad-native-cta:hover svg {
		transform: translateX(3px);
	}
</style>
