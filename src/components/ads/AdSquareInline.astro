---
interface Props {
	label?: string;
	size?: '300x250' | '400x400';
}
const { label = '', size = '300x250' } = Astro.props;
---

<div class:list={['ad-square-inline', `ad-square-inline--${size}`]}>
	<div class="ad-inner" data-ad-size={size}>
		{label && <span class="ad-label">{label}</span>}
		<slot />
	</div>
</div>

<style>
	.ad-square-inline {
		display: flex;
		justify-content: center;
		margin: calc(var(--spacing-unit) * 4) 0;
	}

	.ad-inner {
		background: var(--color-background-alt);
		border: 1px dashed var(--color-border);
		border-radius: 8px;
		width: 300px;
		max-width: 100%;
		height: 250px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.ad-square-inline--400x400 .ad-inner {
		width: 400px;
		height: 400px;
	}

	:global(.ad-creative) {
		display: block;
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		text-decoration: none;
	}

	:global(.ad-creative > img) {
		width: 100% !important;
		height: 100% !important;
		max-width: none !important;
		max-height: none !important;
		object-fit: cover;
		margin: 0 !important;
	}

	:global(.ad-creative__copy) {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.75rem;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
		color: #fff;
		text-align: center;
		font-size: 0.85rem;
		line-height: 1.4;
	}

	:global(.ad-creative__copy strong) {
		display: block;
		color: #fff !important;
		margin-bottom: 0.2rem;
		font-size: 1rem;
	}

	.ad-label {
		position: absolute;
		top: 4px;
		left: 8px;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-light);
		opacity: 0.6;
	}

	@media (max-width: 767px) {
		.ad-square-inline--400x400 .ad-inner {
			width: 300px;
			height: 250px;
		}
	}
</style>
