---
interface Props {
	label?: string;
}
const { label = 'Advertisement' } = Astro.props;
---

<div class="ad-square-inline">
	<div class="ad-inner" data-ad-size="400x400">
		<span class="ad-label">{label}</span>
		<slot />
	</div>
</div>

<style>
	.ad-square-inline {
		display: flex;
		justify-content: center;
		margin: calc(var(--spacing-unit) * 8) 0;
	}

	.ad-inner {
		background: var(--color-background-alt);
		border: 1px dashed var(--color-border);
		border-radius: 8px;
		width: 400px;
		max-width: 100%;
		height: 400px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.ad-label {
		position: absolute;
		top: 4px;
		left: 8px;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-light);
		opacity: 0.6;
	}

	@media (max-width: 767px) {
		.ad-inner {
			width: 300px;
			height: 250px;
		}
	}
</style>
