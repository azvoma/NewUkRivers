---
import type { River } from '../lib/supabase';

export interface Props {
  river: River;
}

const { river } = Astro.props;
---

<article class="river-card">
  <div class="river-card-header">
    <h3>{river.name}</h3>
    <span class="region-badge">{river.region}</span>
  </div>

  <div class="river-info">
    {river.length_miles && (
      <div class="info-item">
        <span class="info-label">Length:</span>
        <span class="info-value">{river.length_miles} miles ({river.length_km} km)</span>
      </div>
    )}
    {river.origin && (
      <div class="info-item">
        <span class="info-label">Origin:</span>
        <span class="info-value">{river.origin}</span>
      </div>
    )}
  </div>

  {river.description && (
    <p class="river-description">{river.description.substring(0, 150)}...</p>
  )}

  <div class="river-features">
    {river.has_gold && (
      <span class="feature-badge gold">Contains Gold</span>
    )}
    {river.activities && river.activities.length > 0 && (
      <span class="feature-badge activities">{river.activities.length} Activities</span>
    )}
    {river.wildlife && river.wildlife.length > 0 && (
      <span class="feature-badge wildlife">{river.wildlife.length} Species</span>
    )}
  </div>

  <a href={`/rivers/${river.slug}`} class="view-button">
    View Details →
  </a>
</article>

<style>
  .river-card {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    padding: calc(var(--spacing-unit) * 3);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 2);
  }

  .river-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 102, 204, 0.12);
    transform: translateY(-4px);
  }

  .river-card-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: calc(var(--spacing-unit) * 2);
  }

  .river-card h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .region-badge {
    background: var(--color-secondary);
    color: white;
    padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 1.5);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .river-info {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 1);
  }

  .info-item {
    display: flex;
    gap: calc(var(--spacing-unit) * 1);
    font-size: 0.9375rem;
  }

  .info-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .info-value {
    color: var(--color-text-light);
  }

  .river-description {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }

  .river-features {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing-unit) * 1);
  }

  .feature-badge {
    padding: calc(var(--spacing-unit) * 0.75) calc(var(--spacing-unit) * 1.5);
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .feature-badge.gold {
    background: #fef3c7;
    color: #92400e;
  }

  .feature-badge.activities {
    background: #dbeafe;
    color: #1e40af;
  }

  .feature-badge.wildlife {
    background: #d1fae5;
    color: #065f46;
  }

  .view-button {
    align-self: flex-start;
    background: var(--color-primary);
    color: white;
    padding: calc(var(--spacing-unit) * 1.5) calc(var(--spacing-unit) * 3);
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .view-button:hover {
    background: var(--color-primary-dark);
    transform: translateX(4px);
  }
</style>
