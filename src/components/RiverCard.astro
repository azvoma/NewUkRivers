---
import type { River } from '../lib/supabase';

export interface Props {
  river: River;
}

const { river } = Astro.props;

const localCardImages: Record<string, string> = {
  'river-avon-bristol': '/images/rivers/river-avon-bristol/River_Avon_(Bristol).jpg',
  'river-avon-warwickshire': '/images/rivers/river-avon-warwickshire/River_Avon_(Warwickshire).jpg',
  'river-dee-wales': '/images/rivers/river-dee/River_Dee.jpg',
  'river-tweed': '/images/rivers/river-tweed/River_Tweed.jpg'
};

const cardImage = localCardImages[river.slug] || river.image_url;
---

<a href={`/rivers/${river.slug}`} class="river-card" data-activities={river.activities.join('|')} data-region={river.region}>
  {cardImage && (
    <div class="river-image">
      <img src={cardImage} alt={`${river.name} - UK river flowing through ${river.region}`} width="400" height="200" loading="lazy" />
    </div>
  )}

  <div class="river-card-header">
    <h3>{river.name}</h3>
    <span class="region-badge">{river.region}</span>
  </div>

  <div class="river-info">
    {river.length_miles && (
      <div class="info-item">
        <span class="info-label">Length:</span>
        <span class="info-value">{river.length_miles} miles ({river.length_km} km)</span>
      </div>
    )}
    {river.origin && (
      <div class="info-item">
        <span class="info-label">Origin:</span>
        <span class="info-value">{river.origin}</span>
      </div>
    )}
  </div>

  {river.description && (
    <p class="river-description">{river.description.substring(0, 150)}...</p>
  )}

  <div class="river-features">
    {river.has_gold && (
      <span class="feature-badge gold">Contains Gold</span>
    )}
    {river.activities && river.activities.length > 0 && (
      <span class="feature-badge activities">{river.activities.length} Activities</span>
    )}
    {river.wildlife && river.wildlife.length > 0 && (
      <span class="feature-badge wildlife">{river.wildlife.length} Species</span>
    )}
  </div>
</a>

<style>
  .river-card {
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 2);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .river-card:hover {
    border-color: #17c0e8;
    box-shadow: 0 8px 24px rgba(13, 59, 158, 0.15);
    transform: translateY(-4px);
  }

  .river-card:focus {
    outline: 2px solid #0d3b9e;
    outline-offset: 2px;
  }

  .river-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .river-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .river-card:hover .river-image img {
    transform: scale(1.05);
  }

  .river-card > *:not(.river-image) {
    padding: 0 calc(var(--spacing-unit) * 3);
  }

  .river-card > .river-features {
    padding-bottom: calc(var(--spacing-unit) * 3);
  }

  .river-card-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: calc(var(--spacing-unit) * 2);
  }

  .river-card h3 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .region-badge {
    background: #17c0e8;
    color: white;
    padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 1.5);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .river-info {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit) * 1);
  }

  .info-item {
    display: flex;
    gap: calc(var(--spacing-unit) * 1);
    font-size: 0.9375rem;
  }

  .info-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .info-value {
    color: var(--color-text-light);
  }

  .river-description {
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }

  .river-features {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing-unit) * 1);
  }

  .feature-badge {
    padding: calc(var(--spacing-unit) * 0.75) calc(var(--spacing-unit) * 1.5);
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .feature-badge.gold {
    background: #fef3c7;
    color: #92400e;
  }

  .feature-badge.activities {
    background: #dceffe;
    color: #0d3b9e;
  }

  .feature-badge.wildlife {
    background: #d0f4fc;
    color: #0b6c8a;
  }
</style>
